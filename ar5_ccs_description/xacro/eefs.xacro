<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="collider" default="simple"/>

    <xacro:include filename="$(find jodell_description)/xacro/RG75-300.xacro"/>
    <xacro:include filename="$(find changingtek_description)/xacro/AG2F90-C.xacro"/>
    <xacro:include filename="$(find linkerhand_description)/xacro/l6.xacro"/>

    <xacro:macro name="Ocs2SideEefFrame" params="side parent_link">
        <link name="${side}_eef"/>
        <joint name="${side}_eef_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="${side}_eef"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="SideEndEffector" params="side hand_type gripper_type gripper_pad eef_fixed_joints:=false">
        <xacro:if value="${gripper_type == '' and hand_type == ''}">
            <xacro:Ocs2SideEefFrame side="${side}" parent_link="${side}_tcp"/>
        </xacro:if>

        <xacro:if value="${gripper_type == 'rg75'}">
            <xacro:RG75-300 name="${side}" use_flange="true" pad="${gripper_pad}" kinematic_only="${eef_fixed_joints}"/>
            <joint name="${side}_gripper_base_joint" type="fixed">
                <origin xyz="0 0 -0.0045"/>
                <parent link="${side}_tcp"/>
                <child link="${side}_flange"/>
            </joint>
        </xacro:if>

        <xacro:if value="${gripper_type == 'ag2f90_c' or gripper_type == 'ag2f90_d'}">
            <xacro:property name="ag2f90_pad" value="${'none' if gripper_type == 'ag2f90_d' else gripper_pad}"/>
            <xacro:AG2F90-C name="${side}" use_flange="true" pad="${ag2f90_pad}" kinematic_only="${eef_fixed_joints}"/>
            <joint name="${side}_gripper_base_joint" type="fixed">
                <origin xyz="0 0 0"/>
                <parent link="${side}_tcp"/>
                <child link="${side}_flange"/>
            </joint>
        </xacro:if>

        <xacro:if value="${hand_type == 'linkerhand_l6'}">
            <xacro:LinkerHandL6 name="${side}_hand" direction="${1 if side == 'left' else -1}"
                                use_flange="true" fixed_joints="${eef_fixed_joints}"/>
            <joint name="${side}_hand_base_joint" type="fixed">
                <origin rpy="0 0 ${3.141592653589793 if side == 'left' else 0}"/>
                <parent link="${side}_tcp"/>
                <child link="${side}_hand_flange"/>
            </joint>
        </xacro:if>
    </xacro:macro>

    <xacro:macro name="EndEffectors"
                 params="eef_fixed_joints:=false
                         left_hand_type:='' left_gripper_type:='' left_gripper_pad:='default'
                         right_hand_type:='' right_gripper_type:='' right_gripper_pad:='default'">
        <xacro:SideEndEffector side="left"
                               eef_fixed_joints="${eef_fixed_joints}"
                               hand_type="${left_hand_type}"
                               gripper_type="${left_gripper_type}"
                               gripper_pad="${left_gripper_pad}"/>
        <xacro:SideEndEffector side="right"
                               eef_fixed_joints="${eef_fixed_joints}"
                               hand_type="${right_hand_type}"
                               gripper_type="${right_gripper_type}"
                               gripper_pad="${right_gripper_pad}"/>
    </xacro:macro>
</robot>
