<?xml version="1.0"?>
<robot name="AR5_CCS" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="collider" default="convex"/>
	<xacro:arg name="skin" default="default"/>
	<xacro:arg name="variant" default=""/>
	<xacro:arg name="type" default="dual"/>
	<xacro:arg name="left_type" default=""/>
	<xacro:arg name="right_type" default=""/>
	<xacro:arg name="eef_fixed_joints" default="false"/>
	<!-- 从 type 参数解析 arm_config / 对称末端 -->
	<xacro:property name="type_arg" value="$(arg type)"/>
	<xacro:property name="variant_arg" value="$(arg variant)"/>
	<xacro:property name="left_type_arg" value="$(arg left_type)"/>
	<xacro:property name="right_type_arg" value="$(arg right_type)"/>
	<xacro:property name="effective_left_type" value="${left_type_arg if left_type_arg != '' else type_arg}"/>
	<xacro:property name="effective_right_type" value="${right_type_arg if right_type_arg != '' else type_arg}"/>

	<!-- 默认值 -->
	<xacro:property name="selected_arm_config" value="dual"/>
	<xacro:property name="selected_gripper_type" value="none"/>
	<xacro:property name="selected_gripper_pad" value="default"/>

	<!-- 单臂配置 -->
	<xacro:if value="${type_arg == 'left'}">
		<xacro:property name="selected_arm_config" value="left"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'right'}">
		<xacro:property name="selected_arm_config" value="right"/>
	</xacro:if>

	<!-- 双臂配置：对称 type → selected_gripper_type / selected_gripper_pad -->
	<xacro:if value="${type_arg == 'rg75'}">
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'rg75_heavy'}">
		<xacro:property name="selected_gripper_type" value="rg75"/>
		<xacro:property name="selected_gripper_pad" value="heavy_carry"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90' or type_arg == 'ag2f90_d'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_d"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90_c'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90_c_soft'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
		<xacro:property name="selected_gripper_pad" value="soft"/>
	</xacro:if>

	<!-- Include Component Macros -->
	<xacro:include filename="$(find ar5_ccs_description)/xacro/arm_ccs.xacro"/>
	<xacro:include filename="$(find ar5_ccs_description)/xacro/arm_mount.xacro"/>

	<!-- <xacro:include filename="$(find ar5_ccs_description)/xacro/grippers.xacro"/> -->

	<!-- 根据 arm_config 创建机械臂 -->
	<xacro:if value="${selected_arm_config == 'left'}">
		<xacro:AR5_CCS name="" collider="$(arg collider)" direction="1"/>
	</xacro:if>
	<xacro:if value="${selected_arm_config == 'right'}">
		<xacro:AR5_CCS name="" collider="$(arg collider)" direction="-1"/>
	</xacro:if>

	<xacro:if value="${selected_arm_config == 'dual'}">
		<link name="base_link"/>
		<link name="arm_base">
			<collision>
				<origin xyz="0.0091 0 -0.096"/>
				<geometry>
					<box size="0.33 0.30 0.5029"/>
				</geometry>
			</collision>
		</link>

		<joint name="arm_base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="arm_base"/>
		</joint>

		<xacro:DualArmMount parent="arm_base"/>

		<xacro:AR5_CCS name="left" collider="$(arg collider)" direction="1"/>
		<xacro:AR5_CCS name="right" collider="$(arg collider)" direction="-1"/>

		<xacro:include filename="$(find ar5_ccs_description)/xacro/eef_type_resolver.xacro"/>
		<xacro:set_side_eef_types side="left" type_key="${effective_left_type}"/>
		<xacro:set_side_eef_types side="right" type_key="${effective_right_type}"/>
		<xacro:include filename="$(find ar5_ccs_description)/xacro/eefs.xacro"/>
		<xacro:EndEffectors
			eef_fixed_joints="$(arg eef_fixed_joints)"
			left_hand_type="${left_hand_type}"
			left_gripper_type="${left_gripper_type}"
			left_gripper_pad="${left_gripper_pad}"
			right_hand_type="${right_hand_type}"
			right_gripper_type="${right_gripper_type}"
			right_gripper_pad="${right_gripper_pad}"/>
	</xacro:if>

</robot>
