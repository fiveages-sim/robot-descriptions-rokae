<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="rokae_side_hardware_block" params="
        side
        arm_ip
        local_ip
        cpu_affinity
        ctrl_mode
        command_filter_mode
        command_filter_max_velocity
        command_filter_max_acceleration
        command_filter_max_jerk
        gripper_type
        gripper_pad
        hand_type
        load_mass
        load_cog
        load_inertia">
        <plugin>rokae_ros2_control/RokaeHardware</plugin>
        <param name="arm_ip">${arm_ip}</param>
        <param name="ctrl_mode">${ctrl_mode}</param>
        <param name="joint_impedance">200,200,200,200,20,20,20</param>
        <param name="local_ip">${local_ip}</param>
        <param name="cpu_affinity">${cpu_affinity}</param>
        <param name="command_filter_mode">${command_filter_mode}</param>
        <param name="command_filter_max_velocity">${command_filter_max_velocity}</param>
        <param name="command_filter_max_acceleration">${command_filter_max_acceleration}</param>
        <param name="command_filter_max_jerk">${command_filter_max_jerk}</param>

        <xacro:if value="${gripper_type == 'rg75'}">
            <param name="gripper_type">jodell</param>
            <param name="${side}_tool_torque">1.0</param>
            <param name="${side}_tool_velocity">1.0</param>
        </xacro:if>
        <xacro:if value="${gripper_type == 'erg32'}">
            <param name="gripper_type">erg32</param>
            <param name="${side}_tool_torque">1.0</param>
            <param name="${side}_tool_velocity">1.0</param>
        </xacro:if>
        <xacro:if value="${gripper_type == 'ag2f90_c' or gripper_type == 'ag2f90_d'}">
            <param name="gripper_type">${gripper_type}</param>
            <param name="gripper_slave_id">1</param>
            <param name="gripper_close_pos">9000</param>
            <param name="gripper_max_opening_distance">1.0</param>
            <param name="gripper_configure_xpanel">false</param>
            <param name="${side}_tool_torque">1.0</param>
            <param name="${side}_tool_velocity">1.0</param>
        </xacro:if>
        <xacro:if value="${gripper_type == 'ag2f120s'}">
            <param name="gripper_type">ag2f120s</param>
            <param name="gripper_slave_id">1</param>
            <param name="gripper_close_pos">12000</param>
            <param name="gripper_max_opening_distance">0.12</param>
            <param name="gripper_configure_xpanel">false</param>
            <param name="${side}_tool_torque">1.0</param>
            <param name="${side}_tool_velocity">1.0</param>
        </xacro:if>
        <xacro:if value="${gripper_type == 'ag2f120s_d'}">
            <param name="gripper_type">ag2f120s_d</param>
            <param name="gripper_slave_id">1</param>
            <param name="gripper_close_pos">1000</param>
            <param name="gripper_max_opening_distance">0.10</param>
            <param name="gripper_configure_xpanel">false</param>
            <param name="${side}_tool_torque">1.0</param>
            <param name="${side}_tool_velocity">1.0</param>
        </xacro:if>
        <xacro:if value="${hand_type == 'linkerhand_o6' or hand_type == 'linkerhand_l6' or hand_type == 'linkerhand_o7'}">
            <param name="gripper_type">${hand_type}</param>
            <param name="hand_slave_id">${40 if side == 'left' else 39}</param>
            <param name="hand_configure_xpanel">false</param>
            <param name="${side}_tool_torque">1.0</param>
            <param name="${side}_tool_velocity">1.0</param>
        </xacro:if>
        <xacro:tool_load_params
            side="${side}"
            end_effector_type="${gripper_type if gripper_type != '' else hand_type}"
            pad_type="${gripper_pad}"
            mass="${load_mass}"
            center_of_mass="${load_cog}"
            diagonal_inertia="${load_inertia}"/>
    </xacro:macro>

</robot>
