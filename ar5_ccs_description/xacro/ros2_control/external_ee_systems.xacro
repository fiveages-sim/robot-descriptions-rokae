<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find ar5_ccs_description)/xacro/ros2_control/end_effector_interfaces.xacro"/>
    <xacro:include filename="$(find jodell_description)/xacro/ros2_control/side_systems.xacro"/>
    <xacro:include filename="$(find changingtek_description)/xacro/ros2_control/side_systems.xacro"/>
    <xacro:include filename="$(find freedom_description)/xacro/ros2_control/side_systems.xacro"/>
    <xacro:include filename="$(find inspire_description)/xacro/ros2_control/side_systems.xacro"/>
    <xacro:include filename="$(find theohand_description)/xacro/ros2_control/side_systems.xacro"/>
    <xacro:include filename="$(find xhand1_description)/xacro/ros2_control/side_systems.xacro"/>

    <xacro:macro name="side_usb_hand_system" params="side hand_type serial_port rw_rate:=''">
        <xacro:property name="usb_hand_system_name" value="${str('linkerhand_7' if hand_type == 'linkerhand_o7' else 'linkerhand_6')}"/>
        <xacro:property name="usb_hand_rw_rate" value="${rw_rate if rw_rate != '' else 30}"/>
        <ros2_control name="${usb_hand_system_name}_${side}_system" type="system" rw_rate="${usb_hand_rw_rate}">
            <hardware>
                <plugin>modbus_ros2_control/DexterousHandHardware</plugin>
                <param name="serial_port">${serial_port}</param>
                <param name="hand_type">${hand_type}</param>
                <param name="hand_side">${side}</param>
                <param name="max_speed_ratio">1.0</param>
            </hardware>
            <xacro:side_hand_interfaces side="${side}" hand_type="${hand_type}"/>
        </ros2_control>
    </xacro:macro>

    <xacro:macro name="ag2f90d_inex_rs485_side_system" params="side rs485_channel slave_id">
        <ros2_control name="ag2f90_d_${side}_inex_rs485_system" type="system" rw_rate="30">
            <hardware>
                <plugin>inex_ros2_control/Ag2f90dHardware</plugin>
                <param name="hand_side">${side}</param>
                <param name="rs485_channel">${rs485_channel}</param>
                <param name="slave_id">${slave_id}</param>
                <param name="transaction_interval_ms">10</param>
                <param name="feedback_period_ms">33</param>
                <param name="feedback_timeout_ms">100</param>
                <param name="command_deadband_raw">0</param>
                <param name="max_consecutive_failures">5</param>
                <param name="read_feedback">true</param>
                <param name="${side}_tool_velocity">1.0</param>
                <param name="${side}_tool_torque">1.0</param>
            </hardware>
            <xacro:side_gripper_joint side="${side}"/>
        </ros2_control>
    </xacro:macro>

    <xacro:macro name="linkerhand_inex_can_side_system" params="side hand_type">
        <!-- rw_rate controls how often ros2_control offers a new position target.
             The plugin independently enforces the iNexus CAN TX frame interval. -->
        <ros2_control name="${hand_type}_${side}_inex_can_system" type="system" rw_rate="50">
            <hardware>
                <xacro:if value="${hand_type == 'linkerhand_o6'}">
                    <plugin>inex_ros2_control/O6Hardware</plugin>
                </xacro:if>
                <xacro:if value="${hand_type == 'linkerhand_l6'}">
                    <plugin>inex_ros2_control/L6Hardware</plugin>
                </xacro:if>
                <xacro:if value="${hand_type == 'linkerhand_o7'}">
                    <plugin>inex_ros2_control/O7Hardware</plugin>
                </xacro:if>
                <param name="hand_side">${side}</param>
                <param name="read_feedback">true</param>
                <param name="tx_interval_ms">5</param>
                <param name="position_feedback_period_ms">20</param>
                <param name="position_feedback_timeout_ms">40</param>
                <param name="${side}_tool_torque">1.0</param>
                <param name="${side}_tool_velocity">1.0</param>
            </hardware>
            <xacro:side_hand_interfaces side="${side}" hand_type="${hand_type}"/>
        </ros2_control>
    </xacro:macro>

    <xacro:macro name="linkerhand_inex_rs485_side_system" params="side hand_type rs485_channel">
        <ros2_control name="${hand_type}_${side}_inex_rs485_system" type="system" rw_rate="30">
            <hardware>
                <xacro:if value="${hand_type == 'linkerhand_o6'}">
                    <plugin>inex_ros2_control/O6LinkerHandRs485Hardware</plugin>
                </xacro:if>
                <xacro:if value="${hand_type == 'linkerhand_l6'}">
                    <plugin>inex_ros2_control/L6LinkerHandRs485Hardware</plugin>
                </xacro:if>
                <xacro:if value="${hand_type == 'linkerhand_o7'}">
                    <plugin>inex_ros2_control/O7LinkerHandRs485Hardware</plugin>
                </xacro:if>
                <param name="hand_side">${side}</param>
                <param name="rs485_channel">${rs485_channel}</param>
                <!-- slave_id intentionally omitted: right=0x27, left=0x28. -->
                <param name="transaction_interval_ms">10</param>
                <param name="position_period_ms">33</param>
                <param name="position_feedback_period_ms">33</param>
                <param name="position_feedback_timeout_ms">40</param>
                <param name="command_deadband_raw">0</param>
                <param name="max_consecutive_failures">5</param>
                <param name="read_feedback">true</param>
                <param name="${side}_tool_torque">1.0</param>
                <param name="${side}_tool_velocity">1.0</param>
            </hardware>
            <xacro:side_hand_interfaces side="${side}" hand_type="${hand_type}"/>
        </ros2_control>
    </xacro:macro>

    <xacro:macro name="linkerhand_usb_can_side_system" params="side hand_type can_interface read_tactile:=false">
        <ros2_control name="${hand_type}_${side}_can_system" type="system" rw_rate="50">
            <hardware>
                <xacro:if value="${hand_type == 'linkerhand_o6'}">
                    <plugin>can_ros2_control/O6CanHardware</plugin>
                </xacro:if>
                <xacro:if value="${hand_type == 'linkerhand_l6'}">
                    <plugin>can_ros2_control/L6CanHardware</plugin>
                </xacro:if>
                <xacro:if value="${hand_type == 'linkerhand_o7'}">
                    <plugin>can_ros2_control/O7CanHardware</plugin>
                </xacro:if>
                <param name="can_interface">${can_interface}</param>
                <param name="hand_side">${side}</param>
                <param name="read_feedback">true</param>
                <param name="read_tactile">${read_tactile}</param>
                <param name="${side}_tool_torque">1.0</param>
                <param name="${side}_tool_velocity">1.0</param>
            </hardware>
            <xacro:side_hand_interfaces side="${side}" hand_type="${hand_type}"/>
        </ros2_control>
    </xacro:macro>

    <xacro:macro name="external_ee_systems" params="
        usb_left_port:=/dev/ttyUSB0
        usb_right_port:=/dev/ttyUSB2
        left_ee_can_interface:=can0
        right_ee_can_interface:=can1
        left_ee_rs485_channel:=1
        right_ee_rs485_channel:=1
        left_ee_modbus_slave_id:=1
        right_ee_modbus_slave_id:=1
        left_read_tactile:=false
        right_read_tactile:=false
        left_ee_rw_rate:=''
        right_ee_rw_rate:=''
        usb_baudrate:=115200">
        <xacro:if value="${arm_driver == 'inex' and left_drive_type == 'inex_rs485' and left_gripper_type == 'ag2f90_d'}">
            <xacro:ag2f90d_inex_rs485_side_system side="left" rs485_channel="${left_ee_rs485_channel}" slave_id="${left_ee_modbus_slave_id}"/>
        </xacro:if>
        <xacro:if value="${arm_driver == 'inex' and right_drive_type == 'inex_rs485' and right_gripper_type == 'ag2f90_d'}">
            <xacro:ag2f90d_inex_rs485_side_system side="right" rs485_channel="${right_ee_rs485_channel}" slave_id="${right_ee_modbus_slave_id}"/>
        </xacro:if>
        <xacro:if value="${arm_driver == 'inex' and left_drive_type == 'inex_rs485' and (left_hand_type == 'linkerhand_o6' or left_hand_type == 'linkerhand_l6' or left_hand_type == 'linkerhand_o7')}">
            <xacro:linkerhand_inex_rs485_side_system side="left" hand_type="${left_hand_type}" rs485_channel="${left_ee_rs485_channel}"/>
        </xacro:if>
        <xacro:if value="${arm_driver == 'inex' and right_drive_type == 'inex_rs485' and (right_hand_type == 'linkerhand_o6' or right_hand_type == 'linkerhand_l6' or right_hand_type == 'linkerhand_o7')}">
            <xacro:linkerhand_inex_rs485_side_system side="right" hand_type="${right_hand_type}" rs485_channel="${right_ee_rs485_channel}"/>
        </xacro:if>
        <xacro:if value="${arm_driver == 'inex' and left_drive_type == 'inex_can' and (left_hand_type == 'linkerhand_o6' or left_hand_type == 'linkerhand_l6' or left_hand_type == 'linkerhand_o7')}">
            <xacro:linkerhand_inex_can_side_system side="left" hand_type="${left_hand_type}"/>
        </xacro:if>
        <xacro:if value="${arm_driver == 'inex' and right_drive_type == 'inex_can' and (right_hand_type == 'linkerhand_o6' or right_hand_type == 'linkerhand_l6' or right_hand_type == 'linkerhand_o7')}">
            <xacro:linkerhand_inex_can_side_system side="right" hand_type="${right_hand_type}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type == 'usb_can' and (left_hand_type == 'linkerhand_o6' or left_hand_type == 'linkerhand_l6' or left_hand_type == 'linkerhand_o7')}">
            <xacro:linkerhand_usb_can_side_system side="left" hand_type="${left_hand_type}" can_interface="${left_ee_can_interface}" read_tactile="${left_read_tactile}" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type == 'usb_can' and (right_hand_type == 'linkerhand_o6' or right_hand_type == 'linkerhand_l6' or right_hand_type == 'linkerhand_o7')}">
            <xacro:linkerhand_usb_can_side_system side="right" hand_type="${right_hand_type}" can_interface="${right_ee_can_interface}" read_tactile="${right_read_tactile}" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type in ('usb', 'usb_rs485') and (left_hand_type == 'linkerhand_o6' or left_hand_type == 'linkerhand_l6' or left_hand_type == 'linkerhand_o7')}">
            <xacro:side_usb_hand_system side="left" hand_type="${left_hand_type}" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type in ('usb', 'usb_rs485') and (right_hand_type == 'linkerhand_o6' or right_hand_type == 'linkerhand_l6' or right_hand_type == 'linkerhand_o7')}">
            <xacro:side_usb_hand_system side="right" hand_type="${right_hand_type}" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type in ('usb', 'usb_rs485') and left_hand_type == 'theohand_std16a'}">
            <xacro:theohand_usb_side_system side="left" serial_port="${usb_left_port}" baudrate="${usb_baudrate}" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type in ('usb', 'usb_rs485') and right_hand_type == 'theohand_std16a'}">
            <xacro:theohand_usb_side_system side="right" serial_port="${usb_right_port}" baudrate="${usb_baudrate}" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type in ('usb', 'usb_rs485') and left_hand_type in ('inspire_e2', 'inspire_f2')}">
            <xacro:inspire_rs485_side_system side="left" serial_port="${usb_left_port}" hand_type="${left_hand_type}" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type in ('usb', 'usb_rs485') and right_hand_type in ('inspire_e2', 'inspire_f2')}">
            <xacro:inspire_rs485_side_system side="right" serial_port="${usb_right_port}" hand_type="${right_hand_type}" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type in ('usb', 'usb_rs485') and left_hand_type in ('freedom_v1', 'freedom_v2')}">
            <xacro:freedom_rs485_side_system side="left" serial_port="${usb_left_port}" type="${'freedomv2' if left_hand_type == 'freedom_v2' else 'freedomv1'}" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type in ('usb', 'usb_rs485') and right_hand_type in ('freedom_v1', 'freedom_v2')}">
            <xacro:freedom_rs485_side_system side="right" serial_port="${usb_right_port}" type="${'freedomv2' if right_hand_type == 'freedom_v2' else 'freedomv1'}" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type in ('usb', 'usb_rs485') and left_hand_type == 'xhand1'}">
            <xacro:xhand1_rs485_side_system side="left" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type in ('usb', 'usb_rs485') and right_hand_type == 'xhand1'}">
            <xacro:xhand1_rs485_side_system side="right" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'freedom_v1'}">
            <xacro:freedom_can_side_system side="left" can_interface="${left_ee_can_interface}" device_id="0" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'freedom_v1'}">
            <xacro:freedom_can_side_system side="right" can_interface="${right_ee_can_interface}" device_id="1" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type == 'usb_can' and left_hand_type in ('inspire_e2', 'inspire_f2')}">
            <xacro:inspire_canfd_side_system side="left" can_interface="${left_ee_can_interface}" hand_type="${left_hand_type}" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type == 'usb_can' and right_hand_type in ('inspire_e2', 'inspire_f2')}">
            <xacro:inspire_canfd_side_system side="right" can_interface="${right_ee_can_interface}" hand_type="${right_hand_type}" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type in ('usb', 'usb_rs485') and left_gripper_type == 'ag2f90_d'}">
            <xacro:changingtek_usb_side_system side="left" variant="90d" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type in ('usb', 'usb_rs485') and right_gripper_type == 'ag2f90_d'}">
            <xacro:changingtek_usb_side_system side="right" variant="90d" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${left_drive_type in ('usb', 'usb_rs485') and left_gripper_type == 'rg75'}">
            <xacro:jodell_usb_side_system side="left" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
        </xacro:if>
        <xacro:if value="${right_drive_type in ('usb', 'usb_rs485') and right_gripper_type == 'rg75'}">
            <xacro:jodell_usb_side_system side="right" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
        </xacro:if>
    </xacro:macro>

</robot>
