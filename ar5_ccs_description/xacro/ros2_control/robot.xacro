<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="AR5_CCS">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="arm_hardware_driver" default="inex"/>
	<xacro:arg name="arm_ctrl_mode" default="position"/>
	<xacro:arg name="inex_state_timeout_ms" default="50"/>
	<xacro:arg name="inex_command_hold_timeout_ms" default="20"/>
	<xacro:arg name="inex_command_fault_timeout_ms" default="200"/>
	<xacro:arg name="left_arm_ip" default="192.168.1.160"/>
	<xacro:arg name="left_local_ip" default="192.168.1.233"/>
	<xacro:arg name="right_arm_ip" default="192.168.0.160"/>
	<xacro:arg name="right_local_ip" default="192.168.0.233"/>
	<xacro:arg name="left_arm_cpu_affinity" default="2"/>
	<xacro:arg name="right_arm_cpu_affinity" default="3"/>
	<xacro:arg name="left_load_mass" default=""/>
	<xacro:arg name="left_load_cog" default=""/>
	<xacro:arg name="left_load_inertia" default=""/>
	<xacro:arg name="right_load_mass" default=""/>
	<xacro:arg name="right_load_cog" default=""/>
	<xacro:arg name="right_load_inertia" default=""/>
	<xacro:arg name="rokae_command_filter_mode" default="double_s"/>
	<xacro:arg name="rokae_command_filter_max_velocity" default="6.0"/>
	<xacro:arg name="rokae_command_filter_max_acceleration" default="30.0"/>
	<xacro:arg name="rokae_command_filter_max_jerk" default="300.0"/>
	<xacro:arg name="usb_left_port" default="/dev/ttyUSB0"/>
	<xacro:arg name="usb_right_port" default="/dev/ttyUSB2"/>
	<xacro:arg name="left_ee_can_interface" default="can0"/>
	<xacro:arg name="right_ee_can_interface" default="can1"/>
	<xacro:arg name="left_read_tactile" default="false"/>
	<xacro:arg name="right_read_tactile" default="false"/>
	<xacro:arg name="left_ee_drive_type" default="none"/>
	<xacro:arg name="right_ee_drive_type" default="none"/>
	<xacro:property name="arm_driver" value="$(arg arm_hardware_driver)"/>
	<xacro:property name="is_real_hardware" value="${'$(arg ros2_control_hardware_type)' == 'real'}"/>
	<xacro:property name="left_drive_type" value="$(arg left_ee_drive_type)"/>
	<xacro:property name="right_drive_type" value="$(arg right_ee_drive_type)"/>
	<xacro:property name="validated_hardware_type" value="${1 if '$(arg ros2_control_hardware_type)' in ('mock_components', 'gz', 'isaac', 'real') else 0}"/>
	<xacro:property name="validated_arm_driver" value="${1 if arm_driver in ('rokae', 'inex') else 0}"/>
	<xacro:property name="validated_left_drive" value="${1 if arm_driver + ':' + left_drive_type in ('rokae:none', 'rokae:rokae_rs485', 'rokae:usb_rs485', 'rokae:usb_can', 'rokae:ethernet', 'inex:none', 'inex:inex_rs485', 'inex:inex_can', 'inex:usb_rs485', 'inex:usb_can', 'inex:ethernet') else 0}"/>
	<xacro:property name="validated_right_drive" value="${1 if arm_driver + ':' + right_drive_type in ('rokae:none', 'rokae:rokae_rs485', 'rokae:usb_rs485', 'rokae:usb_can', 'rokae:ethernet', 'inex:none', 'inex:inex_rs485', 'inex:inex_can', 'inex:usb_rs485', 'inex:usb_can', 'inex:ethernet') else 0}"/>
	<xacro:property name="rokae_ctrl_mode" value="${'JOINT_IMPEDANCE' if '$(arg arm_ctrl_mode)' == 'joint_impedance' else 'POSITION'}"/>
	<!-- INEX needs the selected EEF type for payload lookup even when the EEF uses an external bus. -->
	<xacro:property name="left_arm_hand_type" value="${left_hand_type if arm_driver == 'inex' or left_drive_type == 'rokae_rs485' else ''}"/>
	<xacro:property name="right_arm_hand_type" value="${right_hand_type if arm_driver == 'inex' or right_drive_type == 'rokae_rs485' else ''}"/>
	<xacro:property name="left_arm_gripper_type" value="${left_gripper_type if arm_driver == 'inex' or left_drive_type == 'rokae_rs485' else ''}"/>
	<xacro:property name="right_arm_gripper_type" value="${right_gripper_type if arm_driver == 'inex' or right_drive_type == 'rokae_rs485' else ''}"/>
	<link name="world"/>

	<joint name="world_fixed" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin/>
	</joint>

	<xacro:include filename="$(find ar5_ccs_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find ar5_ccs_description)/xacro/ros2_control/end_effector_interfaces.xacro"/>
	<xacro:include filename="$(find ar5_ccs_description)/xacro/ros2_control/arm_hardware.xacro"/>
	<xacro:include filename="$(find ar5_ccs_description)/xacro/ros2_control/external_ee_systems.xacro"/>
	<xacro:property name="configuration_validated" value="${validated_hardware_type + validated_arm_driver + validated_left_drive + validated_right_drive}"/>
	<xacro:property name="validation_guard" value="${(1,)[0 if configuration_validated == 4 else 1]}"/>
	<xacro:if value="${validation_guard > 0}"/>

	<xacro:if value="${is_real_hardware}">

		<xacro:if value="${selected_arm_config == 'dual'}">
			<ros2_control name="ar5_left_system" type="system">
				<hardware>
					<xacro:arm_side_hardware_block driver="${arm_driver}" side="left" robot_mode="2"
						arm_ip="$(arg left_arm_ip)" local_ip="$(arg left_local_ip)" cpu_affinity="$(arg left_arm_cpu_affinity)" ctrl_mode="${rokae_ctrl_mode}"
						state_timeout_ms="$(arg inex_state_timeout_ms)" command_hold_timeout_ms="$(arg inex_command_hold_timeout_ms)" command_fault_timeout_ms="$(arg inex_command_fault_timeout_ms)"
						command_filter_mode="$(arg rokae_command_filter_mode)" command_filter_max_velocity="$(arg rokae_command_filter_max_velocity)"
						command_filter_max_acceleration="$(arg rokae_command_filter_max_acceleration)" command_filter_max_jerk="$(arg rokae_command_filter_max_jerk)"
						gripper_type="${left_arm_gripper_type}" gripper_pad="${left_gripper_pad}" hand_type="${left_arm_hand_type}"
						payload_end_effector_type="${left_gripper_type if left_gripper_type != '' else left_hand_type}"
						load_mass="$(arg left_load_mass)" load_cog="$(arg left_load_cog)" load_inertia="$(arg left_load_inertia)"/>
				</hardware>
				<xacro:if value="${arm_driver == 'rokae' and left_drive_type == 'rokae_rs485'}"><xacro:side_arm_ee_block side="left" mode="real" hand_type="${left_arm_hand_type}" gripper_type="${left_arm_gripper_type}"/></xacro:if>
				<xacro:unless value="${arm_driver == 'rokae' and left_drive_type == 'rokae_rs485'}"><xacro:ar5_interfaces name="left"/></xacro:unless>
			</ros2_control>
			<ros2_control name="ar5_right_system" type="system">
				<hardware>
					<xacro:arm_side_hardware_block driver="${arm_driver}" side="right" robot_mode="2"
						arm_ip="$(arg right_arm_ip)" local_ip="$(arg right_local_ip)" cpu_affinity="$(arg right_arm_cpu_affinity)" ctrl_mode="${rokae_ctrl_mode}"
						state_timeout_ms="$(arg inex_state_timeout_ms)" command_hold_timeout_ms="$(arg inex_command_hold_timeout_ms)" command_fault_timeout_ms="$(arg inex_command_fault_timeout_ms)"
						command_filter_mode="$(arg rokae_command_filter_mode)" command_filter_max_velocity="$(arg rokae_command_filter_max_velocity)"
						command_filter_max_acceleration="$(arg rokae_command_filter_max_acceleration)" command_filter_max_jerk="$(arg rokae_command_filter_max_jerk)"
						gripper_type="${right_arm_gripper_type}" gripper_pad="${right_gripper_pad}" hand_type="${right_arm_hand_type}"
						payload_end_effector_type="${right_gripper_type if right_gripper_type != '' else right_hand_type}"
						load_mass="$(arg right_load_mass)" load_cog="$(arg right_load_cog)" load_inertia="$(arg right_load_inertia)"/>
				</hardware>
				<xacro:if value="${arm_driver == 'rokae' and right_drive_type == 'rokae_rs485'}"><xacro:side_arm_ee_block side="right" mode="real" hand_type="${right_arm_hand_type}" gripper_type="${right_arm_gripper_type}"/></xacro:if>
				<xacro:unless value="${arm_driver == 'rokae' and right_drive_type == 'rokae_rs485'}"><xacro:ar5_interfaces name="right"/></xacro:unless>
			</ros2_control>
		</xacro:if>

		<xacro:unless value="${selected_arm_config == 'dual'}">
			<xacro:property name="single_side" value="${'left' if selected_arm_config == 'left' else 'right'}"/>
			<ros2_control name="ar5System" type="system">
				<hardware>
					<xacro:arm_side_hardware_block driver="${arm_driver}" side="${single_side}" robot_mode="${0 if selected_arm_config == 'left' else 1}"
						arm_ip="${'$(arg left_arm_ip)' if selected_arm_config == 'left' else '$(arg right_arm_ip)'}" local_ip="${'$(arg left_local_ip)' if selected_arm_config == 'left' else '$(arg right_local_ip)'}"
						cpu_affinity="${'$(arg left_arm_cpu_affinity)' if selected_arm_config == 'left' else '$(arg right_arm_cpu_affinity)'}" ctrl_mode="${rokae_ctrl_mode}"
						state_timeout_ms="$(arg inex_state_timeout_ms)" command_hold_timeout_ms="$(arg inex_command_hold_timeout_ms)" command_fault_timeout_ms="$(arg inex_command_fault_timeout_ms)"
						command_filter_mode="$(arg rokae_command_filter_mode)" command_filter_max_velocity="$(arg rokae_command_filter_max_velocity)"
						command_filter_max_acceleration="$(arg rokae_command_filter_max_acceleration)" command_filter_max_jerk="$(arg rokae_command_filter_max_jerk)"
						gripper_type="${left_arm_gripper_type if selected_arm_config == 'left' else right_arm_gripper_type}"
						gripper_pad="${left_gripper_pad if selected_arm_config == 'left' else right_gripper_pad}"
						hand_type="${left_arm_hand_type if selected_arm_config == 'left' else right_arm_hand_type}"
						payload_end_effector_type="${(left_gripper_type if left_gripper_type != '' else left_hand_type) if selected_arm_config == 'left' else (right_gripper_type if right_gripper_type != '' else right_hand_type)}"
						load_mass="${'$(arg left_load_mass)' if selected_arm_config == 'left' else '$(arg right_load_mass)'}"
						load_cog="${'$(arg left_load_cog)' if selected_arm_config == 'left' else '$(arg right_load_cog)'}"
						load_inertia="${'$(arg left_load_inertia)' if selected_arm_config == 'left' else '$(arg right_load_inertia)'}"/>
				</hardware>
				<xacro:ar5_interfaces name="${single_side}"/>
			</ros2_control>
		</xacro:unless>

		<xacro:external_ee_systems
			usb_left_port="$(arg usb_left_port)"
			usb_right_port="$(arg usb_right_port)"
			left_ee_can_interface="$(arg left_ee_can_interface)"
			right_ee_can_interface="$(arg right_ee_can_interface)"
			left_read_tactile="$(arg left_read_tactile)"
			right_read_tactile="$(arg right_read_tactile)"/>
	</xacro:if>

	<xacro:unless value="${is_real_hardware}">
		<ros2_control name="ar5System" type="system">
			<hardware>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
					<plugin>gz_ros2_control/GazeboSimSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
					<plugin>mock_components/GenericSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
					<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
					<param name="joint_commands_topic">/isaac/joint_command</param>
					<param name="joint_states_topic">/isaac/joint_states</param>
					<param name="sum_wrapped_joint_states">false</param>
					<param name="initialize_commands_from_state">true</param>
				</xacro:if>
			</hardware>

			<xacro:if value="${selected_arm_config == 'dual'}">
				<xacro:dual_arm_ee_block mode="sim"/>
			</xacro:if>
			<xacro:unless value="${selected_arm_config == 'dual'}">
				<xacro:single_arm_ee_block mode="sim" gripper_type="${selected_gripper_type}"/>
			</xacro:unless>
		</ros2_control>
	</xacro:unless>

	<xacro:arg name="gazebo" default="false"/>
	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<xacro:if value="${selected_arm_config == 'left'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/ros2_controllers.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'right'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/right.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'dual'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/dual.yaml</parameters>
				</xacro:if>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>
