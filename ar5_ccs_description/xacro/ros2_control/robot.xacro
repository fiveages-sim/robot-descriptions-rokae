<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="AR5_CCS">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="arm_ctrl_mode" default="position"/>
	<xacro:arg name="inex_auto_power_on" default="true"/>
	<xacro:arg name="inex_auto_power_off" default="true"/>
	<xacro:arg name="inex_state_timeout_ms" default="50"/>
	<xacro:arg name="inex_command_hold_timeout_ms" default="20"/>
	<xacro:arg name="inex_command_fault_timeout_ms" default="200"/>
	<xacro:arg name="left_arm_ip" default="192.168.1.160"/>
	<xacro:arg name="left_local_ip" default="192.168.1.233"/>
	<xacro:arg name="right_arm_ip" default="192.168.0.160"/>
	<xacro:arg name="right_local_ip" default="192.168.0.233"/>
	<xacro:arg name="left_arm_cpu_affinity" default="2"/>
	<xacro:arg name="right_arm_cpu_affinity" default="3"/>
	<xacro:arg name="left_load_mass" default=""/>
	<xacro:arg name="left_load_cog" default=""/>
	<xacro:arg name="left_load_inertia" default=""/>
	<xacro:arg name="right_load_mass" default=""/>
	<xacro:arg name="right_load_cog" default=""/>
	<xacro:arg name="right_load_inertia" default=""/>
	<xacro:arg name="rokae_command_filter_mode" default="double_s"/>
	<xacro:arg name="rokae_command_filter_max_velocity" default="6.0"/>
	<xacro:arg name="rokae_command_filter_max_acceleration" default="30.0"/>
	<xacro:arg name="rokae_command_filter_max_jerk" default="300.0"/>
	<xacro:arg name="usb_left_port" default="/dev/ttyUSB0"/>
	<xacro:arg name="usb_right_port" default="/dev/ttyUSB2"/>
	<xacro:arg name="left_ee_drive_type" default=""/>
	<xacro:arg name="right_ee_drive_type" default=""/>
	<xacro:property name="is_real_hardware" value="${'$(arg ros2_control_hardware_type)' == 'real' or '$(arg ros2_control_hardware_type)' == 'real_usb'}"/>
	<xacro:property name="ee_drive_type" value="${'usb' if '$(arg ros2_control_hardware_type)' == 'real_usb' else ''}"/>
	<xacro:property name="left_drive_type" value="${'$(arg left_ee_drive_type)' if '$(arg left_ee_drive_type)' != '' else ee_drive_type}"/>
	<xacro:property name="right_drive_type" value="${'$(arg right_ee_drive_type)' if '$(arg right_ee_drive_type)' != '' else ee_drive_type}"/>
	<xacro:property name="rokae_ctrl_mode" value="${'JOINT_IMPEDANCE' if '$(arg arm_ctrl_mode)' == 'joint_impedance' else 'POSITION'}"/>
	<xacro:property name="left_rokae_hand_type" value="${'' if left_drive_type == 'usb' else left_hand_type}"/>
	<xacro:property name="right_rokae_hand_type" value="${'' if right_drive_type == 'usb' else right_hand_type}"/>
	<link name="world"/>

	<joint name="world_fixed" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin/>
	</joint>

	<xacro:include filename="$(find ar5_ccs_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find ar5_ccs_description)/xacro/ros2_control/end_effector_interfaces.xacro"/>
	<xacro:include filename="$(find ar5_ccs_description)/xacro/ros2_control/rokae_hardware.xacro"/>
	<xacro:include filename="$(find ar5_ccs_description)/xacro/ros2_control/external_ee_systems.xacro"/>

	<xacro:if value="${is_real_hardware}">

		<xacro:if value="${selected_arm_config == 'dual'}">
			<ros2_control name="ar5_left_system" type="system">
				<hardware>
					<plugin>inex_ros2_control/InexSystemHardware</plugin>
					<param name="side">left</param>
					<param name="robot_mode">2</param>
					<param name="ctrl_mode">${rokae_ctrl_mode}</param>
					<param name="joint_stiffness">100,100,100,100,50,50,50</param>
					<param name="auto_power_on">$(arg inex_auto_power_on)</param>
					<param name="auto_power_off">$(arg inex_auto_power_off)</param>
					<param name="manage_robot_mode">true</param>
					<param name="state_timeout_ms">$(arg inex_state_timeout_ms)</param>
					<param name="command_hold_timeout_ms">$(arg inex_command_hold_timeout_ms)</param>
					<param name="command_fault_timeout_ms">$(arg inex_command_fault_timeout_ms)</param>
					<param name="rt_cpu_affinity">$(arg left_arm_cpu_affinity)</param>
					<param name="rt_priority">80</param>
					<param name="require_realtime">true</param>
					<param name="lock_memory">true</param>
				</hardware>
				<!-- iNexus migration phase 1: arm joints only. -->
				<xacro:ar5_interfaces name="left"/>
			</ros2_control>
			<ros2_control name="ar5_right_system" type="system">
				<hardware>
					<plugin>inex_ros2_control/InexSystemHardware</plugin>
					<param name="side">right</param>
					<param name="robot_mode">2</param>
					<param name="ctrl_mode">${rokae_ctrl_mode}</param>
					<param name="joint_stiffness">100,100,100,100,50,50,50</param>
					<param name="auto_power_on">$(arg inex_auto_power_on)</param>
					<param name="auto_power_off">$(arg inex_auto_power_off)</param>
					<param name="manage_robot_mode">true</param>
					<param name="state_timeout_ms">$(arg inex_state_timeout_ms)</param>
					<param name="command_hold_timeout_ms">$(arg inex_command_hold_timeout_ms)</param>
					<param name="command_fault_timeout_ms">$(arg inex_command_fault_timeout_ms)</param>
					<param name="rt_cpu_affinity">$(arg right_arm_cpu_affinity)</param>
					<param name="rt_priority">80</param>
					<param name="require_realtime">true</param>
					<param name="lock_memory">true</param>
				</hardware>
				<xacro:ar5_interfaces name="right"/>
			</ros2_control>
		</xacro:if>

		<xacro:unless value="${selected_arm_config == 'dual'}">
			<xacro:property name="single_side" value="${'left' if selected_arm_config == 'left' else 'right'}"/>
			<ros2_control name="ar5System" type="system">
				<hardware>
					<plugin>inex_ros2_control/InexSystemHardware</plugin>
					<param name="side">${single_side}</param>
					<param name="robot_mode">${0 if selected_arm_config == 'left' else 1}</param>
					<param name="ctrl_mode">${rokae_ctrl_mode}</param>
					<param name="joint_stiffness">100,100,100,100,50,50,50</param>
					<param name="auto_power_on">$(arg inex_auto_power_on)</param>
					<param name="auto_power_off">$(arg inex_auto_power_off)</param>
					<param name="manage_robot_mode">true</param>
					<param name="state_timeout_ms">$(arg inex_state_timeout_ms)</param>
					<param name="command_hold_timeout_ms">$(arg inex_command_hold_timeout_ms)</param>
					<param name="command_fault_timeout_ms">$(arg inex_command_fault_timeout_ms)</param>
					<param name="rt_cpu_affinity">${'$(arg left_arm_cpu_affinity)' if selected_arm_config == 'left' else '$(arg right_arm_cpu_affinity)'}</param>
					<param name="rt_priority">80</param>
					<param name="require_realtime">true</param>
					<param name="lock_memory">true</param>
				</hardware>
				<xacro:ar5_interfaces name="${single_side}"/>
			</ros2_control>
		</xacro:unless>

		<xacro:external_ee_systems
			usb_left_port="$(arg usb_left_port)"
			usb_right_port="$(arg usb_right_port)"/>
	</xacro:if>

	<xacro:unless value="${is_real_hardware}">
		<ros2_control name="ar5System" type="system">
			<hardware>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
					<plugin>gz_ros2_control/GazeboSimSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
					<plugin>mock_components/GenericSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
					<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
					<param name="joint_commands_topic">/isaac/joint_command</param>
					<param name="joint_states_topic">/isaac/joint_states</param>
					<param name="sum_wrapped_joint_states">false</param>
					<param name="initialize_commands_from_state">true</param>
				</xacro:if>
			</hardware>

			<xacro:if value="${selected_arm_config == 'dual'}">
				<xacro:dual_arm_ee_block mode="sim"/>
			</xacro:if>
			<xacro:unless value="${selected_arm_config == 'dual'}">
				<xacro:single_arm_ee_block mode="sim" gripper_type="${selected_gripper_type}"/>
			</xacro:unless>
		</ros2_control>
	</xacro:unless>

	<xacro:arg name="gazebo" default="false"/>
	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<xacro:if value="${selected_arm_config == 'left'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/ros2_controllers.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'right'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/right.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'dual'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/dual.yaml</parameters>
				</xacro:if>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>
