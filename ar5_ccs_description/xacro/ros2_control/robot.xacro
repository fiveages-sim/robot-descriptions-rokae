<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="AR5_CCS">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="left_arm_cpu_affinity" default="2"/>
	<xacro:arg name="right_arm_cpu_affinity" default="3"/>
	<xacro:arg name="rokae_command_filter_mode" default="double_s"/>
	<xacro:arg name="rokae_command_filter_max_velocity" default="6.0"/>
	<xacro:arg name="rokae_command_filter_max_acceleration" default="30.0"/>
	<xacro:arg name="rokae_command_filter_max_jerk" default="300.0"/>
	<xacro:arg name="rokae_sdk_filter_limit_enable" default="true"/>
	<xacro:arg name="rokae_sdk_filter_limit" default="10"/>
	<xacro:arg name="rokae_sdk_filter_frequency_1" default="10"/>
	<xacro:arg name="rokae_sdk_filter_frequency_2" default="10"/>
	<xacro:arg name="rokae_sdk_filter_frequency_3" default="10"/>

	<link name="world"/>

	<joint name="world_fixed" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin/>
	</joint>

	<xacro:include filename="$(find ar5_ccs_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find ar5_ccs_description)/xacro/ros2_control/interfaces.xacro"/>

	<!-- 使用 robot.xacro 中已定义的 property 来判断 -->
	<!-- selected_arm_config: left, right, dual -->
	<!-- selected_gripper_type: '' 或 rg75 -->

	<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">

		<xacro:if value="${selected_arm_config == 'dual'}">
			<ros2_control name="ar5_left_system" type="system">
				<hardware>
					<plugin>rokae_ros2_control/RokaeHardware</plugin>
					<param name="arm_ip">192.168.1.160</param>
					<param name="ctrl_mode">POSITION</param>
					<param name="joint_impedance">200,200,200,200,20,20,20</param>
					<param name="local_ip">192.168.1.233</param>
					<param name="cpu_affinity">$(arg left_arm_cpu_affinity)</param>
					<param name="command_filter_mode">$(arg rokae_command_filter_mode)</param>
					<param name="command_filter_max_velocity">$(arg rokae_command_filter_max_velocity)</param>
					<param name="command_filter_max_acceleration">$(arg rokae_command_filter_max_acceleration)</param>
					<param name="command_filter_max_jerk">$(arg rokae_command_filter_max_jerk)</param>
					<param name="sdk_filter_limit_enable">$(arg rokae_sdk_filter_limit_enable)</param>
					<param name="sdk_filter_limit">$(arg rokae_sdk_filter_limit)</param>
					<param name="sdk_filter_frequency_1">$(arg rokae_sdk_filter_frequency_1)</param>
					<param name="sdk_filter_frequency_2">$(arg rokae_sdk_filter_frequency_2)</param>
					<param name="sdk_filter_frequency_3">$(arg rokae_sdk_filter_frequency_3)</param>
					<xacro:if value="${left_gripper_type == 'rg75'}">
						<param name="gripper_type">jodell</param>
						<param name="left_tool_torque">1.0</param>
						<param name="left_tool_velocity">1.0</param>
					</xacro:if>
					<xacro:if value="${left_gripper_type in ('ag2f90_c', 'ag2f90_d')}">
						<param name="gripper_type">${left_gripper_type}</param>
						<param name="gripper_slave_id">1</param>
						<param name="gripper_close_pos">9000</param>
						<param name="gripper_max_opening_distance">1.0</param>
						<param name="gripper_configure_xpanel">false</param>
						<param name="left_tool_torque">1.0</param>
						<param name="left_tool_velocity">1.0</param>
					</xacro:if>
				</hardware>
				<xacro:ar5_interfaces name="left"/>
				<xacro:if value="${left_gripper_type != ''}">
					<joint name="left_gripper_joint">
						<command_interface name="position"/>
						<state_interface name="position">
							<param name="initial_value">0</param>
						</state_interface>
						<state_interface name="velocity"/>
						<state_interface name="effort"/>
					</joint>
				</xacro:if>
			</ros2_control>
			<ros2_control name="ar5_right_system" type="system">
				<hardware>
					<plugin>rokae_ros2_control/RokaeHardware</plugin>
					<param name="arm_ip">192.168.0.160</param>
					<param name="ctrl_mode">POSITION</param>
					<param name="joint_impedance">200,200,200,200,20,20,20</param>
					<param name="local_ip">192.168.0.233</param>
					<param name="cpu_affinity">$(arg right_arm_cpu_affinity)</param>
					<param name="command_filter_mode">$(arg rokae_command_filter_mode)</param>
					<param name="command_filter_max_velocity">$(arg rokae_command_filter_max_velocity)</param>
					<param name="command_filter_max_acceleration">$(arg rokae_command_filter_max_acceleration)</param>
					<param name="command_filter_max_jerk">$(arg rokae_command_filter_max_jerk)</param>
					<param name="sdk_filter_limit_enable">$(arg rokae_sdk_filter_limit_enable)</param>
					<param name="sdk_filter_limit">$(arg rokae_sdk_filter_limit)</param>
					<param name="sdk_filter_frequency_1">$(arg rokae_sdk_filter_frequency_1)</param>
					<param name="sdk_filter_frequency_2">$(arg rokae_sdk_filter_frequency_2)</param>
					<param name="sdk_filter_frequency_3">$(arg rokae_sdk_filter_frequency_3)</param>
					<xacro:if value="${right_gripper_type == 'rg75'}">
						<param name="gripper_type">jodell</param>
						<param name="right_tool_torque">1.0</param>
						<param name="right_tool_velocity">1.0</param>
					</xacro:if>
					<xacro:if value="${right_gripper_type in ('ag2f90_c', 'ag2f90_d')}">
						<param name="gripper_type">${right_gripper_type}</param>
						<param name="gripper_slave_id">1</param>
						<param name="gripper_close_pos">9000</param>
						<param name="gripper_max_opening_distance">1.0</param>
						<param name="gripper_configure_xpanel">false</param>
						<param name="right_tool_torque">1.0</param>
						<param name="right_tool_velocity">1.0</param>
					</xacro:if>
				</hardware>
				<xacro:ar5_interfaces name="right"/>
				<xacro:if value="${right_gripper_type != ''}">
					<joint name="right_gripper_joint">
						<command_interface name="position"/>
						<state_interface name="position">
							<param name="initial_value">0</param>
						</state_interface>
						<state_interface name="velocity"/>
						<state_interface name="effort"/>
					</joint>
				</xacro:if>
			</ros2_control>
		</xacro:if>

		<xacro:unless value="${selected_arm_config == 'dual'}">
			<ros2_control name="ar5System" type="system">
				<hardware>
					<plugin>rokae_ros2_control/RokaeHardware</plugin>
					<!-- 根据 arm_config 设置 arm_ip -->
					<xacro:if value="${selected_arm_config == 'left'}">
						<param name="arm_ip">192.168.1.160</param>
					</xacro:if>
					<xacro:if value="${selected_arm_config == 'right'}">
						<param name="arm_ip">192.168.0.160</param>
					</xacro:if>
					<param name="ctrl_mode">POSITION</param>
					<param name="joint_impedance">200,200,200,200,20,20,20</param>
					<xacro:if value="${selected_arm_config == 'left'}">
						<param name="local_ip">192.168.1.233</param>
					</xacro:if>
					<xacro:if value="${selected_arm_config == 'right'}">
						<param name="local_ip">192.168.0.233</param>
					</xacro:if>
					<param name="cpu_affinity">${'$(arg left_arm_cpu_affinity)' if selected_arm_config == 'left' else '$(arg right_arm_cpu_affinity)'}</param>
					<param name="command_filter_mode">$(arg rokae_command_filter_mode)</param>
					<param name="command_filter_max_velocity">$(arg rokae_command_filter_max_velocity)</param>
					<param name="command_filter_max_acceleration">$(arg rokae_command_filter_max_acceleration)</param>
					<param name="command_filter_max_jerk">$(arg rokae_command_filter_max_jerk)</param>
					<param name="sdk_filter_limit_enable">$(arg rokae_sdk_filter_limit_enable)</param>
					<param name="sdk_filter_limit">$(arg rokae_sdk_filter_limit)</param>
					<param name="sdk_filter_frequency_1">$(arg rokae_sdk_filter_frequency_1)</param>
					<param name="sdk_filter_frequency_2">$(arg rokae_sdk_filter_frequency_2)</param>
					<param name="sdk_filter_frequency_3">$(arg rokae_sdk_filter_frequency_3)</param>
					<xacro:if value="${selected_gripper_type == 'rg75'}">
						<param name="gripper_type">jodell</param>
						<param name="${'left' if selected_arm_config == 'left' else 'right'}_tool_torque">1.0</param>
						<param name="${'left' if selected_arm_config == 'left' else 'right'}_tool_velocity">1.0</param>
					</xacro:if>
					<xacro:if value="${selected_gripper_type in ('ag2f90_c', 'ag2f90_d')}">
						<param name="gripper_type">${selected_gripper_type}</param>
						<param name="gripper_slave_id">1</param>
						<param name="gripper_close_pos">9000</param>
						<param name="gripper_max_opening_distance">1.0</param>
						<param name="gripper_configure_xpanel">false</param>
						<param name="${'left' if selected_arm_config == 'left' else 'right'}_tool_torque">1.0</param>
						<param name="${'left' if selected_arm_config == 'left' else 'right'}_tool_velocity">1.0</param>
					</xacro:if>
				</hardware>
				<xacro:ar5_interfaces name=""/>

				<xacro:if value="${selected_gripper_type != ''}">
					<joint name="gripper_joint">
						<command_interface name="position"/>
						<state_interface name="position">
							<param name="initial_value">0</param>
						</state_interface>
						<state_interface name="velocity"/>
						<state_interface name="effort"/>
					</joint>
				</xacro:if>
			</ros2_control>
		</xacro:unless>
	</xacro:if>

	<xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real'}">
		<ros2_control name="ar5System" type="system">
			<hardware>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
					<plugin>gz_ros2_control/GazeboSimSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
					<plugin>mock_components/GenericSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
					<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
					<param name="joint_commands_topic">/isaac/joint_command</param>
					<param name="joint_states_topic">/isaac/joint_states</param>
					<param name="sum_wrapped_joint_states">false</param>
					<param name="initialize_commands_from_state">true</param>
				</xacro:if>
			</hardware>

			<xacro:if value="${selected_arm_config == 'dual'}">
				<xacro:ar5_interfaces name="left"/>
				<xacro:ar5_interfaces name="right"/>
				<xacro:if value="${left_gripper_type != ''}">
					<joint name="left_gripper_joint">
						<command_interface name="position"/>
						<state_interface name="position">
							<param name="initial_value">0</param>
						</state_interface>
						<state_interface name="velocity"/>
						<state_interface name="effort"/>
					</joint>
				</xacro:if>
				<xacro:if value="${right_gripper_type != ''}">
					<joint name="right_gripper_joint">
						<command_interface name="position"/>
						<state_interface name="position">
							<param name="initial_value">0</param>
						</state_interface>
						<state_interface name="velocity"/>
						<state_interface name="effort"/>
					</joint>
				</xacro:if>
			</xacro:if>
			<xacro:unless value="${selected_arm_config == 'dual'}">
				<xacro:ar5_interfaces name=""/>
				<xacro:if value="${selected_gripper_type != ''}">
					<joint name="gripper_joint">
						<command_interface name="position"/>
						<state_interface name="position">
							<param name="initial_value">0</param>
						</state_interface>
						<state_interface name="velocity"/>
						<state_interface name="effort"/>
					</joint>
				</xacro:if>
			</xacro:unless>

		</ros2_control>
	</xacro:unless>

	<xacro:arg name="gazebo" default="false"/>
	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<xacro:if value="${selected_arm_config == 'left'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/ros2_controllers.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'right'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/right.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'dual'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/dual.yaml</parameters>
				</xacro:if>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>
