<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ccs_arm">

	<xacro:macro name="Arm" params="name direction:=1 collider:=convex">
		<xacro:property name="prefix" value="${name + '_' if name else ''}"/>

		<!-- Base Link -->
		<link name="${prefix}base_link">
			<inertial>
				<mass value="2.4"/>
				<inertia ixx="0.00397965" ixy="0.00000303" ixz="0.00000035" iyy="0.00315361" iyz="0.00002442" izz="0.00357979"/>
				<origin xyz="2.6805e-05 0.0011749210000000002 0.171179958"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/base.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/base.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin xyz="0 0 0.05025"/>
					<geometry>
						<cylinder length="0.105" radius="0.045"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 1 -->
		<joint name="${prefix}joint1" type="revolute">
			<parent link="${prefix}base_link"/>
			<child link="${prefix}link1"/>
			<limit effort="108" lower="-3.1067" upper="3.1067" velocity="3.0543261909900763"/>
			<axis xyz="0 0 1"/>
		</joint>

		<!-- Link 1 -->
		<link name="${prefix}link1">
			<inertial>
				<mass value="2.683"/>
				<inertia ixx="0.00493673" ixy="0.00000160" ixz="${direction*0.00000198}" iyy="0.00452344"
								 iyz="${direction*-0.00000020}" izz="0.00432910"/>
				<origin xyz="${direction*1e-06} ${direction*-0.000621} 0.167909"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link1.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link1.glb" scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 2 -->
		<joint name="${prefix}joint2" type="revolute">
			<parent link="${prefix}link1"/>
			<child link="${prefix}link2"/>
			<limit effort="108" lower="-2.0944" upper="2.0944" velocity="3.0543261909900763"/>
			<axis xyz="0 1 0"/>
			<origin xyz="0.0 0.0 0.1745"/>
		</joint>

		<!-- Link 2 -->
		<link name="${prefix}link2">
			<inertial>
				<mass value="2.3"/>
				<inertia ixx="0.01151906" ixy="0.00000246" ixz="${direction*-0.00000055}" iyy="0.00993335"
								 iyz="${direction*0.00082477}" izz="0.00435237"/>
				<origin xyz="${direction*-2e-05} ${direction*-0.003081} 0.10298600000000001"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link2.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link2.glb" scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin rpy="1.5708 0 0"/>
					<geometry>
						<cylinder length="0.1354" radius="0.0560"/>
					</geometry>
				</collision>
				<collision>
					<origin xyz="0 0 0.11600"/>
					<geometry>
						<cylinder length="0.12413" radius="0.053"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 3 -->
		<joint name="${prefix}joint3" type="revolute">
			<parent link="${prefix}link2"/>
			<child link="${prefix}link3"/>
			<limit effort="66" lower="-3.1067" upper="3.1067" velocity="4.71238898038469"/>
			<axis xyz="0 0 1"/>
			<origin xyz="0.0 0.0 0.314"/>
		</joint>

		<!-- Link 3 -->
		<link name="${prefix}link3">
			<inertial>
				<mass value="1.862"/>
				<inertia ixx="0.00519681" ixy="${direction*0.00001208}" ixz="0.00035761" iyy="0.00470446"
								 iyz="${direction*0.00003430}" izz="0.00266752"/>
				<origin xyz="${direction*0.007097} ${direction*-0.0006590000000000001} -0.016530999999999997"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link3.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link3.glb" scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin xyz="0 0 -0.0863"/>
					<geometry>
						<cylinder length="0.096" radius="0.053"/>
					</geometry>
				</collision>
				<collision>
					<origin xyz="0.00946 0 0" rpy="1.5708 0 0"/>
					<geometry>
						<cylinder length="0.1284" radius="0.0484"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 4 -->
		<joint name="${prefix}joint4" type="revolute">
			<parent link="${prefix}link3"/>
			<child link="${prefix}link4"/>
			<limit effort="66" lower="-1.0472" upper="2.5307" velocity="5.235987755982989"/>
			<axis xyz="0 1 0"/>
			<origin xyz="0.01 0.0 0.0"/>
		</joint>

		<!-- Link 4 -->
		<link name="${prefix}link4">
			<inertial>
				<mass value="1.234"/>
				<inertia ixx="0.00389590" ixy="${direction*-0.00004577}" ixz="-0.00017280" iyy="0.00308657"
								 iyz="${direction*0.00046679}" izz="0.00188364"/>
				<origin xyz="${direction*-0.007826} ${direction*-0.004207} 0.073404"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link4.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link4.glb" scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin xyz="-0.01 0 0.10085"/>
					<geometry>
						<cylinder length="0.10" radius="0.03789"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 5 -->
		<joint name="${prefix}joint5" type="revolute">
			<parent link="${prefix}link4"/>
			<child link="${prefix}link5"/>
			<limit effort="19" lower="-3.1067" upper="3.1067" velocity="4.1887902047863905"/>
			<axis xyz="0 0 1"/>
			<origin xyz="-0.01 0.0 0.272"/>
		</joint>

		<!-- Link 5 -->
		<link name="${prefix}link5">
			<inertial>
				<mass value="1.329"/>
				<inertia ixx="0.00281562" ixy="${direction*0.00001782}" ixz="0.00001650" iyy="0.00221084"
								 iyz="${direction*0.00002100}" izz="0.00182169"/>
				<origin xyz="${direction*0.00028399999999999996} ${direction*0.0016510000000000001} -0.084133"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link5.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link5.glb" scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin xyz="0 0 -0.09397" rpy="1.5708 0 0"/>
					<geometry>
						<cylinder length="0.11" radius="0.042766"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 6 -->
		<joint name="${prefix}joint6" type="revolute">
			<parent link="${prefix}link5"/>
			<child link="${prefix}link6"/>
			<limit effort="19" lower="-1.0472" upper="1.0472" velocity="4.1887902047863905"/>
			<axis xyz="0 1 0"/>
		</joint>

		<!-- Link 6 -->
		<link name="${prefix}link6">
			<inertial>
				<mass value="0.93"/>
				<inertia ixx="0.00072078" ixy="${direction*-0.00000217}" ixz="${direction*0.00000108}" iyy="0.00085153"
								 iyz="${direction*0.00000048}" izz="0.00090205"/>
				<origin xyz="${direction*0.005405999999999999} ${direction*0.000612} -3.9e-05"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link6.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link6.glb" scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin rpy="0 1.5708 0"/>
					<geometry>
						<cylinder length="0.11772" radius="0.044145"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 7 -->
		<joint name="${prefix}joint7" type="revolute">
			<parent link="${prefix}link6"/>
			<child link="${prefix}link7"/>
			<limit effort="19" lower="-1.0472" upper="1.0472" velocity="4.1887902047863905"/>
			<axis xyz="1 0 0"/>
		</joint>

		<!-- Link 7 -->
		<link name="${prefix}link7">
			<inertial>
				<mass value="0.33"/>
				<inertia ixx="0.00051942" ixy="${direction*-0.00000052}" ixz="0.00003721" iyy="0.00079132"
								 iyz="${direction*0.00000265}" izz="0.00045886"/>
				<origin xyz="${direction*-0.00277} ${direction*0.000316} 0.054881"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link7.glb" scale="${direction} 1 1"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find rokae_ar5_description)/meshes/ccs/link7.glb" scale=" ${direction} 1 1"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin xyz="0 0 0.077681"/>
					<geometry>
						<cylinder length="0.038669" radius="0.03559"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- TCP -->
		<link name="${prefix}tcp">
			<inertial>
				<mass value="0.0"/>
				<inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
			</inertial>
		</link>

		<joint name="${prefix}tcp_joint" type="fixed">
			<parent link="${prefix}link7"/>
			<child link="${prefix}tcp"/>
			<origin xyz="0.0 0.0 0.097"/>
		</joint>
	</xacro:macro>
</robot>